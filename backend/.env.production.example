# App
APP_NAME="InsightFlow Edu"
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1

# Security - GENERATE A SECURE KEY FOR PRODUCTION!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightflow

# CORS - Update with your frontend domain
BACKEND_CORS_ORIGINS=["https://your-frontend-domain.com","https://www.your-frontend-domain.com"]

# ML Model
MODEL_PATH=app/ml/risk_model.pkl

# OpenAI (for stretch features)
OPENAI_API_KEY=