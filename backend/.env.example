# App
APP_NAME="InsightFlow Edu"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security (generate a secure key for production!)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightflow

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ML Model
MODEL_PATH=app/ml/risk_model.pkl

# OpenAI (for stretch features)
OPENAI_API_KEY=