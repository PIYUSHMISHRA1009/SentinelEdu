{
  "dashboard": {
    "uid": "insightflow-backend",
    "title": "InsightFlow Backend Metrics",
    "tags": ["insightflow", "backend", "fastapi"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{path}} {{status}}"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Request Latency (p95)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, path))",
            "legendFormat": "p95 {{method}} {{path}}"
          }
        ],
        "yaxes": [
          {
            "format": "seconds",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Active Requests",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "http_requests_in_progress",
            "legendFormat": "{{method}} {{path}}"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Active Requests"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (method, path) / sum(rate(http_requests_total[5m])) by (method, path)",
            "legendFormat": "{{method}} {{path}}"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Error Rate"
          },
          {
            "format": "short"
          }
        ]
      }
    ]
  }
}